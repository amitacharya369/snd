# ==============================================================================
# Signs & Decal Corp. (S+D) — Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env.local FOR LOCAL DEVELOPMENT
# DO NOT COMMIT SENSITIVE VALUES OR ACTUAL PASSWORDS TO THE GIT REPOSITORY
# ==============================================================================

# Application Environment & Base URL
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://www.signsanddecal.com

# SMTP Server Configuration (For Production Inquiry Delivery)
# When configured, inquiries submitted via /contact are dispatched via email.
# If omitted or left empty, inquiries are securely logged to the server audit log.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_secure_smtp_password_placeholder
MAIL_FROM=inquiries@signsanddecal.com
MAIL_TO=salesteam@signsanddecal.com

# Optional Monitoring / Analytics
# NEXT_PUBLIC_ANALYTICS_ID=
